# Dependencies — reinstalled from package-lock.json, never committed.
/node_modules/

# Build output — regenerated by `npm run build`.
/dist/

# Vite writes these next to vite.config.js when the config is reloaded.
vite.config.js.timestamp-*.mjs
/.vite/

# Local secrets. TURSO_DATABASE_URL, TURSO_AUTH_TOKEN and PARTS_WRITE_TOKEN
# live here for CLI runs and in Vercel's env for the deployment. Committing
# any of these would publish write access to the shared reference.
.env
.env.*
!.env.example
# SSH keys belong in ~/.ssh, never in the working tree.
/deploy_key*
*.pem
id_rsa*
id_ed25519*

# Batch OCR working directories — scans, per-invoice JSON and run manifests.
# Regenerable from the source bills and potentially large.
/ocr_out/
/invoices/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# OS / editor noise.
.DS_Store
*.swp
